{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CrushOnAI/world-card/blob/main/spec/world-card-v1.schema.json",
  "title": "World Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "spec_version", "name", "description", "entries"],
  "properties": {
    "spec": {"const": "world-card"},
    "spec_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "language": {"type": "string", "minLength": 2, "maxLength": 35},
    "authors": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scenario": {"type": "string", "maxLength": 12000},
    "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "metadata": {"$ref": "#/$defs/metadata"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "content", "keywords"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "content": {"type": "string", "minLength": 1, "maxLength": 20000},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "category": {"type": "string", "minLength": 1, "maxLength": 80},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "enabled": {"type": "boolean"},
        "extensions": {"type": "object"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "maxLength": 500},
        "license": {"type": "string", "maxLength": 100}
      }
    }
  }
}
